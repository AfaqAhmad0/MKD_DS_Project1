# =============================================================================
# Marketing Assistant AI - Git Ignore Configuration
# =============================================================================
# This file specifies which files and directories Git should ignore.
# =============================================================================

# -----------------------------------------------------------------------------
# Environment & Secrets
# -----------------------------------------------------------------------------
# CRITICAL: Never commit API keys or sensitive configuration
.env
.env.local
.env.*.local
*.pem
*.key
secrets/

# -----------------------------------------------------------------------------
# Python
# -----------------------------------------------------------------------------
# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# PyInstaller
*.manifest
*.spec

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage reports
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/

# Virtual environments
venv/
ENV/
env/
.venv/

# -----------------------------------------------------------------------------
# IDE & Editor
# -----------------------------------------------------------------------------
# VS Code
.vscode/
*.code-workspace

# PyCharm
.idea/
*.iml
*.ipr
*.iws

# Jupyter Notebook
.ipynb_checkpoints/

# Spyder
.spyderproject
.spyproject

# -----------------------------------------------------------------------------
# Data & Models
# -----------------------------------------------------------------------------
# FAISS vector store files (can be large, regenerate from source)
data/vector_store/*.index
data/vector_store/*.pkl

# Temporary data files
*.tmp
*.temp
temp/

# Large data files (if any)
*.csv.gz
*.parquet

# Fine-tuned model artifacts (kept locally, not in git)
backend/models/finetuned-merged/
*.safetensors
*.bin
*.pt
*.onnx
*.tflite
*.zip

# -----------------------------------------------------------------------------
# OS Generated
# -----------------------------------------------------------------------------
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# Linux
*~

# -----------------------------------------------------------------------------
# Logs
# -----------------------------------------------------------------------------
*.log
logs/
