# =============================================================================
# Marketing Assistant AI - Environment Configuration
# =============================================================================
# Cohere API key is required for embeddings and re-ranking.
#
# Setup: Copy this file to .env
#   Windows: copy .env.example .env
#   Linux/Mac: cp .env.example .env
#
# Format rules:
#   - Use KEY=value (no spaces around =)
#   - Boolean values: true/false (lowercase)
#   - Strings with spaces: KEY="value with spaces"
#   - Comments start with #
# =============================================================================

# -----------------------------------------------------------------------------
# Application Settings
# -----------------------------------------------------------------------------
APP_ENV=development
DEBUG=true
API_HOST=0.0.0.0
API_PORT=8000

# -----------------------------------------------------------------------------
# Vector Store
# -----------------------------------------------------------------------------
VECTOR_STORE_PATH=./data/vector_store
EMBEDDING_DIMENSION=1024

# -----------------------------------------------------------------------------
# Cohere Configuration (Embeddings + Re-ranking)
# -----------------------------------------------------------------------------
COHERE_API_KEY=your_cohere_api_key_here
COHERE_EMBED_MODEL=embed-english-v3.0
COHERE_RERANK_MODEL=rerank-english-v3.0

# -----------------------------------------------------------------------------
# LLM Model (Hugging Face Transformers)
# Downloads automatically on first use
#
# Options by RAM:
#   TinyLlama/TinyLlama-1.1B-Chat-v1.0  (~4GB RAM)  - Fast, decent quality
#   Qwen/Qwen2-1.5B-Instruct            (~4GB RAM)  - Good quality
#   microsoft/phi-2                      (~6GB RAM)  - Better quality
#   mistralai/Mistral-7B-Instruct-v0.2  (~16GB RAM) - Best quality
# -----------------------------------------------------------------------------
# HUGGINGFACE_MODEL=./backend/models/finetuned-merged
# HUGGINGFACE_MODEL=TinyLlama/TinyLlama-1.1B-Chat-v1.0
HUGGINGFACE_MODEL=mine0107/MKD_DS_Project1
# -----------------------------------------------------------------------------
# Generation Settings
# -----------------------------------------------------------------------------
# Max tokens to generate (affects response length)
MAX_GENERATION_TOKENS=512

# Temperature (0.0 = deterministic, 1.0 = creative, 2.0 = very random)
GENERATION_TEMPERATURE=0.7

# -----------------------------------------------------------------------------
# Re-ranking Configuration
# -----------------------------------------------------------------------------
# Number of results to keep after re-ranking
RERANK_TOP_N=5
